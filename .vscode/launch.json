{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug acg (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/acg",
      "args": [
        "--matrix",
        "${workspaceFolder}/data/matrices/${input:matrixFile}",
        "--device",
        "gpu",
        "--residual-rtol",
        "1e-6"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "environment": [
        {
          "name": "ONEAPI_DEVICE_SELECTOR",
          "value": "cuda:*"
        },
        {
          "name": "LD_LIBRARY_PATH",
          "value": "/opt/dpcpp/llvm/build/lib:/opt/oneMath/install/lib:${env:LD_LIBRARY_PATH}"
        }
      ],
      "setupCommands": [
        {
          "description": "Enable gdb pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "build acg debug"
    },
    {
      "name": "Debug acg (cuda-gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/acg",
      "args": [
        "--matrix",
        "${workspaceFolder}/data/matrices/${input:matrixFile}",
        "--device",
        "gpu",
        "--residual-rtol",
        "1e-6"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/local/cuda-12.2/bin/cuda-gdb",
      "environment": [
        {
          "name": "ONEAPI_DEVICE_SELECTOR",
          "value": "cuda:*"
        },
        {
          "name": "LD_LIBRARY_PATH",
          "value": "/opt/dpcpp/llvm/build/lib:/opt/oneMath/install/lib:${env:LD_LIBRARY_PATH}"
        }
      ],
      "setupCommands": [
        {
          "description": "Enable gdb pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "build acg debug"
    },
    {
      "name": "Run acg (release)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-release/acg",
      "args": [
        "--matrix",
        "${workspaceFolder}/data/matrices/${input:matrixFile}",
        "--device",
        "gpu",
        "--residual-rtol",
        "1e-6",
        "--manufactured-solution",
        "--max-iters",
        "50000"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "noDebug": true,
      "environment": [
        {
          "name": "ONEAPI_DEVICE_SELECTOR",
          "value": "cuda:*"
        },
        {
          "name": "LD_LIBRARY_PATH",
          "value": "/opt/dpcpp/llvm/build/lib:/opt/oneMath/install/lib:${env:LD_LIBRARY_PATH}"
        }
      ],
      "preLaunchTask": "build acg release"
    },
    {
      "name": "Run acg MPI (release)",
      "type": "cppdbg",
      "request": "launch",
      "program": "/usr/bin/env",
      "args": [
        "mpirun",
        "-n",
        "${input:mpiRanks}",
        "${workspaceFolder}/build-release/acg",
        "--matrix",
        "${workspaceFolder}/data/matrices/${input:matrixFile}",
        "--device",
        "gpu",
        "--residual-rtol",
        "1e-6",
        "--manufactured-solution",
        "--max-iters",
        "50000"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "noDebug": true,
      "environment": [
        {
          "name": "ONEAPI_DEVICE_SELECTOR",
          "value": "cuda:*"
        },
        {
          "name": "LD_LIBRARY_PATH",
          "value": "/opt/dpcpp/llvm/build/lib:/opt/oneMath/install/lib:${env:LD_LIBRARY_PATH}"
        }
      ],
      "preLaunchTask": "build acg release"
    },
    {
      "name": "Debug acg SYCL kernel (gdb-oneapi)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-intel-debug/acg",
      "args": [
        "--matrix",
        "${workspaceFolder}/data/matrices/${input:matrixFile}",
        "--device",
        "gpu",
        "--residual-rtol",
        "1e-6"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/opt/intel/oneapi/debugger/latest/bin/gdb-oneapi",
      "environment": [
        {
          "name": "ONEAPI_DEVICE_SELECTOR",
          "value": "level_zero:gpu"
        },
        {
          "name": "ZE_ENABLE_PROGRAM_DEBUGGING",
          "value": "1"
        },
        {
          "name": "SYCL_CACHE_PERSISTENT",
          "value": "1"
        },
        {
          "name": "LD_LIBRARY_PATH",
          "value": "/opt/dpcpp/llvm/build/lib:/opt/oneMath/install/lib:${env:LD_LIBRARY_PATH}"
        }
      ],
      "setupCommands": [
        {
          "description": "Enable gdb pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Enable SYCL debugger logging",
          "text": "set debug sycl on",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "build acg kernel debug"
    },
    {
      "name": "Debug acg SYCL (gdb-oneapi, OpenCL CPU)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-intel-debug/acg",
      "args": [
        "--matrix",
        "${workspaceFolder}/data/matrices/${input:matrixFile}",
        "--device",
        "cpu",
        "--residual-rtol",
        "1e-6"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/opt/intel/oneapi/debugger/latest/bin/gdb-oneapi",
      "environment": [
        {
          "name": "ONEAPI_DEVICE_SELECTOR",
          "value": "opencl:cpu"
        },
        {
          "name": "SYCL_CACHE_PERSISTENT",
          "value": "1"
        },
        {
          "name": "LD_LIBRARY_PATH",
          "value": "/opt/dpcpp/llvm/build/lib:/opt/oneMath/install/lib:${env:LD_LIBRARY_PATH}"
        }
      ],
      "setupCommands": [
        {
          "description": "Enable gdb pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Enable SYCL debugger logging",
          "text": "set debug sycl on",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "build acg kernel debug"
    }
  ],
  "inputs": [
    {
      "id": "mpiRanks",
      "type": "pickString",
      "description": "Select MPI rank count",
      "default": "2",
      "options": [
        "2",
        "4"
      ]
    },
    {
      "id": "matrixFile",
      "type": "pickString",
      "description": "Select Matrix Market file",
      "default": "Bump_2911/Bump_2911.mtx",
      "options": [
        "Bump_2911/Bump_2911.mtx",
        "tridiag_spd_16x16.mtx",
        "small_spd_3x3.mtx"
      ]
    }
  ]
}
